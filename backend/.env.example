# Server
PORT=8000
NODE_ENV=development

# Database
# DATABASE_URL (Supabase pooler - port 6543 with pgbouncer=true)
DATABASE_URL="postgresql://postgres:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL (Supabase direct connection - port 5432, for migrations only)
DIRECT_URL="postgresql://postgres:password@host.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET=generate_a_strong_random_secret_with_openssl_rand_-hex_64
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
