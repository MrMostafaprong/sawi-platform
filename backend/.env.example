# ============================================
# 🚀 Sawi-Platform — Backend Environment
# ============================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# لا تشارك ملف .env الحقيقي أبداً مع أحد

# Server
PORT=8000
NODE_ENV=development

# ============================================
# Database (Supabase PostgreSQL)
# ============================================
# DATABASE_URL — اتصال عن طريق PgBouncer pooler (للتطبيق)
DATABASE_URL="postgresql://postgres:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL — اتصال مباشر (لـ Prisma migrations فقط)
DIRECT_URL="postgresql://postgres:password@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# ============================================
# JWT (التوثيق)
# ============================================
# JWT_SECRET — أنشئ مفتاح عشوائي وقوي
# استخدم: openssl rand -hex 64
JWT_SECRET=generate_with_openssl_rand_-hex_64
JWT_EXPIRES_IN=7d
# REFRESH — مفتاح مختلف تماماً عن JWT_SECRET
JWT_REFRESH_SECRET=generate_different_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# Rate Limiting (تحديد الطلبات)
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Bcrypt (تشفير كلمات المرور)
# ============================================
BCRYPT_SALT_ROUNDS=12
# ============================================
# CSRF Protection
# ============================================
# مفتاح مختلف عن JWT — استخدم: openssl rand -hex 64
CSRF_SECRET=generate_different_csrf_secret_here
